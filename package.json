{
    "name": "dot",
    "version": "1.0.0",
    "description": "",
    "license": "MIT",
    "author": "",
    "main": "index.js",
    "scripts": {
        "dev": "npm run services:up && npm run migrations:up && next dev",
        "test": "npm run services:up && npm run migrations:up && concurrently -n next,jest --hide next -k --success command-jest \"next dev\" \"npm run test:run\"",
        "posttest": "npm run services:stop",
        "test:run": "wait-on --timeout 90000 http-get://127.0.0.1:3000/api/v1/status && jest --runInBand --verbose",
        "test:watch": "jest --watchAll --runInBand --verbose",
        "services:up": "docker compose -f infra/compose.yaml up -d --wait",
        "services:down": "docker compose -f infra/compose.yaml down",
        "services:stop": "docker compose -f infra/compose.yaml stop",
        "migrations:create": "node-pg-migrate -m infra/migrations --envPath .env.development create",
        "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
        "build": "next build",
        "start": "next start"
    },
    "dependencies": {
        "@auth/pg-adapter": "^1.11.3",
        "docker-compose": "^1.4.2",
        "dotenv": "^17.4.2",
        "jest": "^30.4.2",
        "next": "^16.3.2",
        "next-auth": "^4.24.15",
        "node-pg-migrate": "^9.0.0",
        "pg": "^8.23.0",
        "prettier": "^3.9.6",
        "psql": "^0.0.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "resend": "^6.22.1"
    },
    "devDependencies": {
        "concurrently": "^10.0.5",
        "jest": "^29.6.2",
        "prettier": "^3.8.3",
        "wait-on": "^9.1.0"
    }
}
